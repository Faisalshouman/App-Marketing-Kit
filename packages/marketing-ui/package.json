{
  "name": "@app-marketing/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Configurable React marketing sections and an optional product walkthrough.",
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-navigation.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
